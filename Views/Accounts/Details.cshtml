@model BankAccount
<a asp-action="Index">← All accounts</a><div class="heading"><div><p class="eyebrow">Account #@Model.Id</p><h1>@Model.HolderName</h1><p>Current balance</p><p class="balance">@Model.Balance.ToString("N2")</p></div></div>
<div class="twocol"><div class="panel"><h2>Deposit</h2><form asp-action="Deposit" method="post"><input type="hidden" name="AccountId" value="@Model.Id"/><label for="deposit">Amount</label><input id="deposit" name="Amount" type="number" min="0.01" step="0.01" required/><button class="btn" type="submit">Add money</button></form></div>
<div class="panel"><h2>Withdraw</h2><form asp-action="Withdraw" method="post"><input type="hidden" name="AccountId" value="@Model.Id"/><label for="withdraw">Amount</label><input id="withdraw" name="Amount" type="number" min="0.01" step="0.01" required/><button class="btn secondary" type="submit">Withdraw money</button></form></div></div>
<div class="panel"><h2>Transaction History</h2><table><thead><tr><th>Date (UTC)</th><th>Type</th><th>Amount</th></tr></thead><tbody>
@foreach (var t in Model.Transactions.OrderByDescending(x => x.CreatedAtUtc)) { <tr><td>@t.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@t.Type</td><td>@t.Amount.ToString("N2")</td></tr> }</tbody></table>
@if (!Model.Transactions.Any()) { <p>No transactions yet.</p> }</div>